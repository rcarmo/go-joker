(ns ^{:go-imports []
      :doc "Babashka pods compatibility namespace."}
  pods)

(defn load-pod
  "Starts a Babashka pod process, sends describe, registers it, and returns its
  pod id. The first argument is either an explicit command path or a pod cache
  name. The optional second argument is either a version string for Babashka pod
  cache discovery or a sequence of command arguments."
  {:added "1.0"
   :go "loadPod(args)"}
  ([^String path-or-name])
  ([^String path-or-name version-or-args]))

(defn invoke
  "Synchronously invokes a pod var and returns its decoded result. JSON payloads
  are supported initially; EDN and Transit+JSON return explicit unsupported
  errors until the later codec phases are complete."
  {:added "1.0"
   :go "invokePod(args)"}
  ([^String pod-id var args])
  ([^String pod-id var args opts]))

(defn bencode-encode
  "Encodes a Joker value as bencode bytes, returned as a string. Intended as
  pod protocol plumbing; public for tests and diagnostics."
  {:added "1.0"
   :go "bencodeEncodeObject(x)"}
  [x])

(defn bencode-decode
  "Decodes a bencode string into Joker data. Intended as pod protocol plumbing;
  public for tests and diagnostics."
  {:added "1.0"
   :go "bencodeDecodeBytes(s)"}
  [^String s])
