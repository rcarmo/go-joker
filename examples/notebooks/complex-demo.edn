  {:id "svg-3d-depth" :kind :code :name "svg-3d-depth" :depends-on ["control-room"] :source "(let [faces [{:depth 1 :visible? true :fill \"#334155\" :points \"74,310 626,310 704,238 156,238\"} {:depth 2 :visible? true :fill \"#1d4ed8\" :points \"198,198 310,150 386,188 272,248\"} {:depth 3 :visible? true :fill \"#38bdf8\" :points \"310,150 418,198 386,188 198,198\"} {:depth 4 :visible? false :fill \"#0f172a\" :points \"198,198 272,248 386,188 310,150\"} {:depth 5 :visible? true :fill \"#22c55e\" :points \"272,248 386,188 500,238 382,306\"} {:depth 6 :visible? true :fill \"#0f766e\" :points \"386,188 498,136 616,188 500,238\"} {:depth 7 :visible? true :fill \"#38bdf8\" :points \"498,136 610,184 616,188 386,188\"} {:depth 8 :visible? false :fill \"#064e3b\" :points \"386,188 500,238 616,188 498,136\"} {:depth 9 :visible? true :fill \"#7c3aed\" :points \"298,112 408,64 512,116 402,176\"} {:depth 10 :visible? true :fill \"#a855f7\" :points \"402,176 512,116 570,170 458,238\"} {:depth 11 :visible? true :fill \"#f59e0b\" :points \"298,112 402,176 458,238 344,168\"} {:depth 12 :visible? false :fill \"#581c87\" :points \"344,168 458,238 570,170 512,116\"}] visible (sort-by :depth (filter (fn [face] (:visible? face)) faces)) polygon (fn [face] (str \"<polygon points='\" (:points face) \"' fill='\" (:fill face) \"' stroke='#0f172a' stroke-width='1.4' opacity='.92'/>\")) grid (str (apply str (for [x (range 80 720 48)] (str \"<path d='M\" x \" 330 L\" (- x 120) \" 156'/>\"))) (apply str (for [y (range 150 330 30)] (str \"<path d='M56 \" y \" L704 \" y \"'/>\"))))] (joker.notebook/svg (str \"<svg viewBox='0 0 760 390' role='img' aria-label='Depth culled SVG 3D scene'><rect width='760' height='390' fill='#f8fafc'/><g opacity='.18' stroke='#64748b'>\" grid \"</g><g>\" (apply str (map polygon visible)) \"</g><text x='24' y='32' font-family='ui-sans-serif,system-ui' font-size='18' fill='#0f172a'>SVG 3D scene</text><text x='24' y='56' font-family='ui-monospace,monospace' font-size='12' fill='#475569'>Preprojected faces are depth-sorted; hidden polygons are culled before rendering.</text><text x='24' y='374' font-family='ui-monospace,monospace' font-size='12' fill='#64748b'>visible faces: \" (count visible) \" / \" (count faces) \"</text></svg>\")))" :execution-count 0 :state :idle :outputs []}
  {:id "mandelbrot-params" :kind :code :name "mandelbrot-params" :depends-on [] :source "(joker.notebook/table [{:parameter \"width\" :value 8} {:parameter \"height\" :value 6} {:parameter \"max-iter\" :value 8} {:parameter \"parallelism\" :value \"rows computed with pmap\"} {:parameter \"scale\" :value \"32x display resize\"} {:parameter \"output\" :value \"direct PNG bitmap data\"}])" :execution-count 0 :state :idle :outputs []}
  {:id "mandelbrot" :kind :code :name "mandelbrot" :depends-on ["mandelbrot-params"] :source "(require 'joker.base64)\n(require 'joker.imaging)\n(let [width 8 height 6 max-iter 8 xmin -2.25 ymin -1.25 color (fn [n] (if (= n max-iter) [4 7 20 255] [(mod (+ 20 (* n 7)) 256) (mod (+ 42 (* n 13)) 256) (mod (+ 95 (* n 19)) 256) 255])) pixel (fn [x y] (let [cr (+ xmin (/ (* 3.25 x) width)) ci (+ ymin (/ (* 2.5 y) height)) state (reduce (fn [s _] (let [zr (nth s 0) zi (nth s 1) n (nth s 2) escaped (nth s 3)] (if escaped s (let [nzr (+ (- (* zr zr) (* zi zi)) cr) nzi (+ (* 2 zr zi) ci) nn (+ n 1)] [nzr nzi nn (> (+ (* nzr nzr) (* nzi nzi)) 4.0)])))) [0.0 0.0 0 false] (range max-iter))] (color (nth state 2)))) row (fn [y] (vec (map (fn [x] [x y (pixel x y)]) (range width)))) rows (pmap row (range height)) pixels (apply concat rows) bitmap (reduce (fn [img p] (joker.imaging/set-pixel! img (nth p 0) (nth p 1) (nth p 2))) (joker.imaging/new width height [4 7 20 255]) pixels) scaled (joker.imaging/resize bitmap (* width 32) (* height 32)) png-data (joker.imaging/encode scaled :png)] (joker.notebook/image \"image/png\" (joker.base64/encode-string png-data)))" :execution-count 0 :state :idle :outputs []}
  {:id "summary" :kind :code :name "summary" :depends-on ["mandelbrot" "svg-3d-depth" "dependency-graph"] :source "(joker.notebook/html \"<section style='font-family:ui-sans-serif,system-ui;line-height:1.45'><h3>Execution summary</h3><p>The notebook has generated structured data, charts, a workflow graph, trusted HTML, a projected SVG scene, and a PNG Mandelbrot image using Joker bitmap operations.</p><ul><li>Charts use the ECharts output renderer.</li><li>The Mandelbrot cell computes rows with <code>pmap</code>, then mutates pixels with <code>joker.imaging/set-pixel!</code>.</li><li>The 3D SVG cell performs projection, depth sorting, and back-face culling in Joker code.</li></ul></section>\")" :execution-count 0 :state :idle :outputs []}
