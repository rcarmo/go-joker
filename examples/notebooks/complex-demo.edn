  {:id "mandelbrot"
   :kind :code
   :name "mandelbrot"
   :depends-on ["mandelbrot-params"]
   :source "(require 'joker.imaging)\n(require 'joker.jit)\n\n(let [width 1024\n      height 768\n      max-iter 18\n      xmin -2.25\n      ymin -1.25\n      dx (/ 3.25 width)\n      dy (/ 2.5 height)\n      color-at (joker.jit/compile-wasm\n                 (fn [cr ci]\n                   (loop [zr 0.0\n                          zi 0.0\n                          n 0]\n                     (if (= n max-iter)\n                       (+ (+ (+ (* 4 16777216.0)\n                                (* 7 65536.0))\n                             (* 20 256.0))\n                          255.0)\n                       (if (> (+ (* zr zr) (* zi zi)) 4.0)\n                         (+ (+ (+ (* (+ 20 (* n 7)) 16777216.0)\n                                  (* (+ 42 (* n 13)) 65536.0))\n                               (* (+ 95 (* n 19)) 256.0))\n                            255.0)\n                         (recur (+ (- (* zr zr) (* zi zi)) cr)\n                                (+ (* (* 2.0 zr) zi) ci)\n                                (+ n 1)))))))]\n  (joker.imaging/from-rgba32-domain-fn width height xmin ymin dx dy color-at))"
   :execution-count 12
   :elapsed-ns 795387208
   :state :ok
   :outputs [
    {:type :image
     :mime "image/png"
     :encoding :base64
     :data ""}
   ]}

