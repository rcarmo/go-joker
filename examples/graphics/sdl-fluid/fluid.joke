;; SDL2 calls use joker.ffi. The companion host supplies the allocation-free
;; stable-fluid solver and owned buffers; no SDL binding is compiled into it.
(require '[joker.ffi :as ffi])
(def lib (ffi/open fluid.example/library))
(def init (ffi/bind lib "SDL_Init" [:u32] :i32))
(def quit (ffi/bind lib "SDL_Quit" [] :void))
(def error (ffi/bind lib "SDL_GetError" [] :cstring))
(def window (ffi/bind lib "SDL_CreateWindow" [:cstring :i32 :i32 :i32 :i32 :u32] :pointer))
(def destroy-window (ffi/bind lib "SDL_DestroyWindow" [:pointer] :void))
(def renderer (ffi/bind lib "SDL_CreateRenderer" [:pointer :i32 :u32] :pointer))
(def destroy-renderer (ffi/bind lib "SDL_DestroyRenderer" [:pointer] :void))
(def texture (ffi/bind lib "SDL_CreateTexture" [:pointer :u32 :i32 :i32 :i32] :pointer))
(def destroy-texture (ffi/bind lib "SDL_DestroyTexture" [:pointer] :void))
(def update-texture (ffi/bind lib "SDL_UpdateTexture" [:pointer :pointer :pointer :i32] :i32))
(def copy (ffi/bind lib "SDL_RenderCopy" [:pointer :pointer :pointer :pointer] :i32))
(def present (ffi/bind lib "SDL_RenderPresent" [:pointer] :void))
(def read-pixels (ffi/bind lib "SDL_RenderReadPixels" [:pointer :pointer :u32 :pointer :i32] :i32))
(def poll (ffi/bind lib "SDL_PollEvent" [:pointer] :i32))
(def sdl-delay (ffi/bind lib "SDL_Delay" [:u32] :void))
(def events (ffi/buffer 56))
(defn check [rc] (when (neg? rc) (throw (ex-info (error) {:sdl-code rc}))))
(check (init 32))
(try
(def w (window "Joker FFI / Stable Fluids" 0 0 768 768 0))
(when (nil? w) (throw (ex-info (error) {})))
(def r (renderer w -1 1)) ;; software renderer: deterministic CI capture
(when (nil? r) (throw (ex-info (error) {})))
(def t (texture r 376840196 1 96 96)) ;; SDL_PIXELFORMAT_RGBA32, streaming
(when (nil? t) (throw (ex-info (error) {})))
  (loop [frame 0 running true]
    (when (and running (or (= fluid.example/frames 0) (< frame fluid.example/frames)))
      (fluid.example/step!)
      (check (update-texture t nil fluid.example/pixels 384))
      (check (copy r t nil nil))
      ;; Read actual SDL output before presentation, not the solver buffer.
      (when (= frame (dec fluid.example/frames))
        (check (read-pixels r nil 376840196 fluid.example/capture 3072))
        (println "Saved SDL screenshot:" (fluid.example/save!)))
      (present r)
      (let [alive (loop [alive true]
                    (if (= 1 (poll events))
                      (recur (and alive (not= 256 (ffi/u32 events 0))))
                      alive))]
        (when (= fluid.example/frames 0) (sdl-delay 16))
        (recur (inc frame) alive))))
  (finally
    (when (and (bound? #'t) t) (destroy-texture t))
    (when (and (bound? #'r) r) (destroy-renderer r))
    (when (and (bound? #'w) w) (destroy-window w))
    (quit)))
