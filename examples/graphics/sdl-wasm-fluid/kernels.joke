;; Dense f64 math is authored in Joker, compiled by jit/compile-wasm. No C kernel.
(require '[joker.jit :as jit] '[joker.math :as math])
;; Periodic 96x96 grid, 11 fields: u,v,ut,vt,r,g,b,scratch,p,div,packed RGBA.
(defmacro addr [field x y] `(+ (* ~field 9216) (+ ~x (* ~y 96))))
(defmacro cell [a field x y] `(jit/buffer-get ~a (addr ~field ~x ~y)))
(defmacro put [a field x y value] `(jit/buffer-set! ~a (addr ~field ~x ~y) ~value))
(defmacro clamp01 [v] `(let [z# ~v] (if (< z# 0) 0 (if (> z# 1) 1 z#))))
(defmacro solid [x y] `(let [dx# (- ~x 48) dy# (- ~y 48)] (< (+ (* dx# dx#) (* dy# dy#)) 36)))

(def force-kernel
 (jit/compile-wasm
  (fn [a dt]
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [dx (- x 48) dy (- y 48)
              radius (math/sqrt (+ (* dx dx) (* dy dy) 1))
              ring (clamp01 (- 1 (/ (math/abs (- radius 26)) 5)))
              jet1 (clamp01 (- 1 (/ (+ (* (- x 14) (- x 14)) (* (- y 48) (- y 48))) 20)))
              jet2 (clamp01 (- 1 (/ (+ (* (- x 76) (- x 76)) (* (- y 28) (- y 28))) 20)))
              jet3 (clamp01 (- 1 (/ (+ (* (- x 76) (- x 76)) (* (- y 68) (- y 68))) 20)))]
         (when (not (solid x y))
          (put a 0 x y (+ (cell a 0 x y) (* dt (+ (* ring (/ (- dy) radius) 2) (* jet1 12) (* jet2 -6) (* jet3 -6)))))
          (put a 1 x y (+ (cell a 1 x y) (* dt (+ (* ring (/ dx radius) 2) (* jet2 5) (* jet3 -5)))))
          (put a 4 x y (+ (cell a 4 x y) (* dt (+ (* jet1 14) jet2))))
          (put a 5 x y (+ (cell a 5 x y) (* dt (+ jet1 (* jet2 12) (* jet3 3)))))
          (put a 6 x y (+ (cell a 6 x y) (* dt (+ jet1 (* jet3 16))))))
         (recur (+ x 1))) 0))
       (recur (+ y 1))) 0))) {:buffers [0]}))

(def curl-kernel
 (jit/compile-wasm
  (fn [a dt]
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [xm (if (= x 0) 95 (- x 1)) xp (if (= x 95) 0 (+ x 1))
              ym (if (= y 0) 95 (- y 1)) yp (if (= y 95) 0 (+ y 1))]
         (put a 7 x y (* 0.5 (- (- (cell a 1 xp y) (cell a 1 xm y)) (- (cell a 0 x yp) (cell a 0 x ym)))))
         (recur (+ x 1))) 0))
       (recur (+ y 1))) 0))
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [xm (if (= x 0) 95 (- x 1)) xp (if (= x 95) 0 (+ x 1))
              ym (if (= y 0) 95 (- y 1)) yp (if (= y 95) 0 (+ y 1))
              gx (* 0.5 (- (math/abs (cell a 7 xp y)) (math/abs (cell a 7 xm y))))
              gy (* 0.5 (- (math/abs (cell a 7 x yp)) (math/abs (cell a 7 x ym))))
              scale (/ (* dt 0.7 (cell a 7 x y)) (+ (math/sqrt (+ (* gx gx) (* gy gy))) 0.00001))]
         (put a 0 x y (+ (cell a 0 x y) (* gy scale)))
         (put a 1 x y (- (cell a 1 x y) (* gx scale)))
         (recur (+ x 1))) 0))
       (recur (+ y 1))) 0))) {:buffers [0]}))

(def advect-kernel
 (jit/compile-wasm
  (fn [a dest source dt]
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [xx (- x (* dt 96 (cell a 0 x y))) yy (- y (* dt 96 (cell a 1 x y)))
              xx (if (< xx 0) 0 (if (> xx 94.999) 94.999 xx))
              yy (if (< yy 0) 0 (if (> yy 94.999) 94.999 yy))
              x0 (math/floor xx) y0 (math/floor yy) sx (- xx x0) sy (- yy y0)]
         (put a dest x y
          (if (solid x y) 0
           (* 0.996 (+ (* (- 1 sx) (+ (* (- 1 sy) (cell a source x0 y0)) (* sy (cell a source x0 (+ y0 1)))))
                       (* sx (+ (* (- 1 sy) (cell a source (+ x0 1) y0)) (* sy (cell a source (+ x0 1) (+ y0 1)))))))))
         (recur (+ x 1))) 0))
       (recur (+ y 1))) 0))) {:buffers [0]}))

(def copy-kernel
 (jit/compile-wasm
  (fn [a dest source]
   (loop [i 0]
    (if (< i 9216)
     (do (jit/buffer-set! a (+ (* dest 9216) i) (jit/buffer-get a (+ (* source 9216) i))) (recur (+ i 1))) 0))) {:buffers [0]}))

(def project-kernel
 (jit/compile-wasm
  (fn [a]
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [xm (if (= x 0) 95 (- x 1)) xp (if (= x 95) 0 (+ x 1)) ym (if (= y 0) 95 (- y 1)) yp (if (= y 95) 0 (+ y 1))]
         (put a 9 x y (* -0.5 (/ (+ (- (cell a 0 xp y) (cell a 0 xm y)) (- (cell a 1 x yp) (cell a 1 x ym))) 96)))
         (put a 8 x y 0)
         (recur (+ x 1))) 0)) (recur (+ y 1))) 0))
   (loop [pass 0]
    (if (< pass 18)
     (do (loop [y 0]
       (if (< y 96)
        (do (loop [x 0]
          (if (< x 96)
           (let [xm (if (= x 0) 95 (- x 1)) xp (if (= x 95) 0 (+ x 1)) ym (if (= y 0) 95 (- y 1)) yp (if (= y 95) 0 (+ y 1))]
            (put a 8 x y (if (solid x y) 0 (/ (+ (cell a 9 x y) (cell a 8 xm y) (cell a 8 xp y) (cell a 8 x ym) (cell a 8 x yp)) 4)))
            (recur (+ x 1))) 0)) (recur (+ y 1))) 0)) (recur (+ pass 1))) 0))
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [xm (if (= x 0) 95 (- x 1)) xp (if (= x 95) 0 (+ x 1)) ym (if (= y 0) 95 (- y 1)) yp (if (= y 95) 0 (+ y 1))]
         (put a 0 x y (if (solid x y) 0 (- (cell a 0 x y) (* 48 (- (cell a 8 xp y) (cell a 8 xm y))))))
         (put a 1 x y (if (solid x y) 0 (- (cell a 1 x y) (* 48 (- (cell a 8 x yp) (cell a 8 x ym))))))
         (recur (+ x 1))) 0)) (recur (+ y 1))) 0))) {:buffers [0]}))

(def render-kernel
 (jit/compile-wasm
  (fn [a]
   (loop [y 0]
    (if (< y 96)
     (do (loop [x 0]
       (if (< x 96)
        (let [red (cell a 4 x y) green (cell a 5 x y) blue (cell a 6 x y)
              rr (if (solid x y) 42 (math/floor (* 255 (/ red (+ 0.7 red)))))
              gg (if (solid x y) 56 (math/floor (* 255 (/ green (+ 0.7 green)))))
              bb (if (solid x y) 72 (math/floor (* 255 (/ blue (+ 0.7 blue)))))]
         (put a 10 x y (+ rr (* gg 256) (* bb 65536) 4278190080))
         (recur (+ x 1))) 0)) (recur (+ y 1))) 0))) {:buffers [0]}))

(defn advance! [a]
 (force-kernel a 0.016666666666666666)
 (curl-kernel a 0.016666666666666666)
 (advect-kernel a 2 0 0.016666666666666666)
 (advect-kernel a 3 1 0.016666666666666666)
 (copy-kernel a 0 2) (copy-kernel a 1 3)
 (project-kernel a)
 (advect-kernel a 7 4 0.016666666666666666) (copy-kernel a 4 7)
 (advect-kernel a 7 5 0.016666666666666666) (copy-kernel a 5 7)
 (advect-kernel a 7 6 0.016666666666666666) (copy-kernel a 6 7)
 (render-kernel a))
